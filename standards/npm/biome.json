{
	"$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
	"formatter": { "lineWidth": 100 },
	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"semicolons": "asNeeded",
			"trailingCommas": "none"
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"suspicious": { "noEmptyBlockStatements": "error" },
			"correctness": { "noUnusedVariables": "error" }
		}
	}
}
