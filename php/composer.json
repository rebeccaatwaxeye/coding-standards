{
  "name": "nocturna/logger",
  "version": "0.1.7",
  "description": "Zero-config structured logger for PHP — reference implementation of the Nocturna logging spec (§14)",
  "license": "MIT",
  "type": "library",
  "require": {
    "php": ">=8.1",
    "ext-json": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "Nocturna\\Logger\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Nocturna\\Logger\\Tests\\": "tests/"
    }
  }
}
