{
  "$schema": "https://biomejs.dev/schemas/2.4.12/schema.json",
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": {
        "noEmptyBlockStatements": "error",
        "noConsoleLog": "error"
      },
      "correctness": {
        "noUnusedVariables": "error"
      }
    }
  },
  "_comment": "§14.4 lint config — merges into your project's biome.json under 'linter.rules'"
}
